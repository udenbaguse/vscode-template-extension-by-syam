{
  "name": "vscode-template-extension-by-syam",
  "version": "1.1.0",
  "description": "CLI generator for creating VS Code extension templates.",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "vscode-template-extension-by-syam": "./bin/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/udenbaguse/vscode-template-extension-by-syam.git"
  },
  "homepage": "https://github.com/udenbaguse/vscode-template-extension-by-syam.git#readme",
  "bugs": {
    "url": "https://github.com/udenbaguse/vscode-template-extension-by-syam.git/issues"
  },
  "engines": {
    "node": ">=16"
  },
  "keywords": [
    "vscode",
    "extension",
    "template",
    "generator",
    "cli"
  ],
  "files": [
    "bin",
    "src",
    "scripts",
    ".vscodeignore",
    "webpack.config.js",
    "jsconfig.json",
    "icon.ico",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "node --check src/extension.js && node --check src/hoverProvider.js && node --check src/docsLoader.js",
    "test": "npm run check",
    "merge-docs": "node scripts/merge-docs.js",
    "minify-docs": "node scripts/minify-docs.js",
    "compile": "npm run merge-docs && npm run minify-docs && webpack --mode production",
    "package": "npm run compile && vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.6.0",
    "copy-webpack-plugin": "^12.0.0",
    "esbuild": "^0.28.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.0"
  }
}
